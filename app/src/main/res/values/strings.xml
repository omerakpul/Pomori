    <string name="onboarding_title">Welcome to Pomori</string>
    <string name="onboarding_why_title">Why do we ask for notification access?</string>
    <string name="onboarding_why_body">While your focus session runs, we hold incoming notifications for you. When it ends you see them all in a single digest, so your attention is not broken.</string>
    <string name="onboarding_data_title">What do we store?</string>
    <string name="onboarding_data_body">For each notification we capture, the app name, title, text and time are stored. We never touch apps you mark as exceptions.</string>
    <string name="onboarding_privacy_title">Your data stays on your device</string>
    <string name="onboarding_privacy_body">The app has no internet permission, so nothing is ever sent. Records are deleted automatically after 7 days by default.</string>
